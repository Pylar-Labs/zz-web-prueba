---
import { siteConfig } from "@/content/site.config";

const { testimonials } = siteConfig;
const hasTestimonials = testimonials.length > 0;
---

{
  hasTestimonials && (
    <section id="testimonios" class="py-24 bg-muted/30">
      <div class="container mx-auto max-w-6xl px-4">
        <div class="mb-12 text-center">
          <h2 class="text-4xl font-bold tracking-tight text-foreground break-words">{siteConfig.sections.testimonials.title}</h2>
          {siteConfig.sections.testimonials.subtitle && (
            <p class="mt-4 text-lg text-muted-foreground break-words">{siteConfig.sections.testimonials.subtitle}</p>
          )}
        </div>

        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {testimonials.map((t) => (
            <div class="rounded-2xl border border-border bg-card p-6 shadow-sm">
              <div class="mb-4 flex gap-1">
                {Array.from({ length: 5 }).map((_, i) => (
                  <svg
                    class={`h-4 w-4 ${i < t.rating ? "text-secondary fill-secondary" : "text-border fill-border"}`}
                    viewBox="0 0 20 20"
                  >
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                  </svg>
                ))}
              </div>
              <p class="mb-6 text-sm leading-relaxed text-muted-foreground">"{t.text}"</p>
              <div class="flex items-center gap-3">
                <div class="flex h-10 w-10 items-center justify-center rounded-full bg-primary/10 text-sm font-bold text-primary">
                  {t.name.charAt(0)}
                </div>
                <div>
                  <p class="text-sm font-semibold text-foreground">{t.name}</p>
                  {t.role && <p class="text-xs text-muted-foreground">{t.role}</p>}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )
}
