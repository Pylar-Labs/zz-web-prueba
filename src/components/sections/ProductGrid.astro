---
import { siteConfig } from "@/content/site.config";
import { buttonVariants } from "@/components/ui/button";
import { cn } from "@/lib/utils";
import { fill } from "@/content/ui-text";
import { formatPrice } from "@/content/price-format";

const { products, productGridConfig, contact, ui, currency, language } = siteConfig;
const { showPrice, ctaLabel, groupByCategory } = productGridConfig;

// El catálogo usa siempre el WhatsApp de contacto (no tiene número propio).
function buildWaLink(productName: string) {
  const text = encodeURIComponent(fill(ui.message.product, { product: productName }));
  return `https://wa.me/${contact.whatsapp}?text=${text}`;
}

type Product = (typeof products)[number];

let sections: { category: string; items: Product[] }[];

if (groupByCategory) {
  const categoryMap = new Map<string, Product[]>();
  for (const p of products) {
    const key = p.category ?? "";
    const group = categoryMap.get(key) ?? [];
    group.push(p);
    categoryMap.set(key, group);
  }
  sections = Array.from(categoryMap.entries()).map(([category, items]) => ({
    category,
    items,
  }));
} else {
  sections = [{ category: "", items: [...products] }];
}
---

{products.length > 0 && (
<section id="productos" class="py-24 bg-background">
  <div class="container mx-auto max-w-6xl px-4">
    <div class="mb-12 text-center">
      <h2 class="text-4xl font-bold tracking-tight text-foreground break-words">{siteConfig.sections.products.title}</h2>
      {siteConfig.sections.products.subtitle && (
        <p class="mt-4 text-lg text-muted-foreground break-words">{siteConfig.sections.products.subtitle}</p>
      )}
    </div>

    {
      sections.map(({ category, items }) => (
        <div class="mb-12 last:mb-0">
          {groupByCategory && category && (
            <h3 class="mb-6 text-xl font-semibold text-foreground border-b border-border pb-3">
              {category}
            </h3>
          )}
          <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {items.map((product) => (
              <div class="group flex flex-col overflow-hidden rounded-2xl border border-border bg-card shadow-sm transition-all hover:shadow-md hover:-translate-y-1">
                <div class="relative overflow-hidden bg-muted aspect-[4/3]">
                  <img
                    src={product.image}
                    alt={product.name}
                    class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                    loading="lazy"
                  />
                </div>
                <div class="flex flex-1 flex-col p-5">
                  <h4 class="mb-1 text-base font-semibold text-foreground">{product.name}</h4>
                  <p class="mb-4 flex-1 text-sm text-muted-foreground">{product.description}</p>
                  <div class="flex items-center justify-between gap-3">
                    {showPrice && product.price !== undefined && (
                      <span class="text-lg font-bold text-primary">
                        {formatPrice(product.price, currency, language)}
                      </span>
                    )}
                    <a
                      href={buildWaLink(product.name)}
                      target="_blank"
                      rel="noopener noreferrer"
                      class={cn(
                        buttonVariants({ size: "sm", variant: showPrice ? "outline" : "default" }),
                        // La etiqueta puede tener hasta 40 caracteres: se permite partirla en vez de recortarla.
                        "ml-auto h-auto min-h-8 min-w-0 whitespace-normal py-1.5 text-center",
                      )}
                    >
                      {ctaLabel}
                    </a>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>
)}
